<?xml version="1.0" encoding="UTF-16"?>
<!-- Build Bridge on-demand task. No triggers: it runs only when started with schtasks /Run.
     Runs as the signed-in user (InteractiveToken), never elevated. Register without admin:
     schtasks /Create /TN "Build Bridge Launch" /XML "<USER_HOME>\.buildbridge\bin\build-bridge-launch.task.xml"
     Replace <USER_HOME> before registering. Save the file as UTF-16. -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\Build Bridge Launch</URI>
    <Description>Build Bridge: open one Grok Build session on request. No triggers.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>false</StartWhenAvailable>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers />
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "&lt;USER_HOME&gt;\.buildbridge\bin\bb-launch.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
